# Data de referência fixa (demo/testes). Vazio = data atual.
RAMON_REFERENCE_DATE=2026-09-27
# Carrega o titular de demonstração (demo@ramon.app / demo2026ramon)
RAMON_SEED_DEMO=1
# Origens liberadas no CORS (separadas por vírgula)
RAMON_CORS=https://aurionfinance.com.br,https://www.aurionfinance.com.br,http://localhost:8080
# LLM opcional (DECISÃO PENDENTE D-05). Sem chave, o compositor determinístico responde.
RAMON_LLM_ENABLED=0
ANTHROPIC_API_KEY=
# ---- Dono e administrador da plataforma (secrets do servidor — nunca versionar valores reais)
RAMON_OWNER_NAME=Ramon Junio Araujo Pereira
RAMON_OWNER_EMAIL=ramonjunio07@gmail.com
# CPF do dono: definir SOMENTE no painel de secrets do servidor. Exibido mascarado.
RAMON_OWNER_CPF=
# Senha do dono (10+ caracteres, letras e números). Vazio = token de configuração no log (POST /v1/auth/owner/setup)
